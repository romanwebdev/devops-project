services:
  nginx:
    image: nginx:alpine
    container_name: nginx
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - api_blue
      - api_green
      - web
    restart: unless-stopped

  web:
    image: "{{ web_image }}"
    container_name: web
    restart: unless-stopped

  api_blue:
    image: "{{ api_image }}"
    container_name: api_blue
    env_file:
      - .env
    depends_on:
      - redis
      - mongo
    restart: unless-stopped

  api_green:
    image: "{{ api_image }}"
    container_name: api_green
    env_file:
      - .env
    depends_on:
      - redis
      - mongo
    restart: unless-stopped

  mongo:
    image: mongo:7
    container_name: mongo
    environment:
      MONGO_INITDB_ROOT_USERNAME: root
      MONGO_INITDB_ROOT_PASSWORD_FILE: /run/secrets/mongo_root_password
    secrets:
      - mongo_root_password
    volumes:
      - mongo_data:/data/db
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: redis
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    restart: unless-stopped

secrets:
  mongo_root_password:
    file: ./secrets/mongo_root_password.txt

volumes:
  mongo_data:
  redis_data: