services:
  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - api_blue
      - api_green
    restart: unless-stopped

  api_blue:
    image: "{{ docker_image }}"
    container_name: api_blue
    env_file:
      - .env
    restart: unless-stopped

  api_green:
    image: "{{ docker_image }}"
    container_name: api_green
    env_file:
      - .env
    restart: unless-stopped

  mongo:
    image: mongo:7
    container_name: mongo
    volumes:
      - mongo_data:/data/db
    restart: unless-stopped

volumes:
  mongo_data: